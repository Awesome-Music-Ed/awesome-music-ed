---
import { getCollection } from "astro:content";
import Default from "@astrojs/starlight/components/PageTitle.astro";

const docs = await getCollection("docs");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
let pathname = Astro.url.pathname.replace(/\/$/, "");
if (base && pathname.startsWith(base)) {
    pathname = pathname.slice(base.length);
}
const id = pathname.replace(/^\//, "") || "index";
const entry = docs.find((d) => d.id === id);

const title = Astro.props.title || entry?.data?.title || "No Title";
const { url, createdBy } = entry?.data || {};
---

<div class="page-title-container">
    {
        url ? (
            <h1 id="_top">
                <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="title-link"
                >
                    {title}
                    <svg
                        aria-hidden="true"
                        focusable="false"
                        class="external-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                </a>
            </h1>
        ) : (
            <Default {...Astro.props} />
        )
    }

    {
        createdBy && (
            <p class="created-by">
                by <span class="creator">{createdBy}</span>
            </p>
        )
    }
</div>

<style>
    .page-title-container {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    h1 {
        margin: 0 !important;
    }

    .title-link {
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .title-link:hover {
        color: var(--sl-color-accent-high);
    }

    .external-icon {
        width: 1rem;
        height: 1rem;
        opacity: 0.6;
        flex-shrink: 0;
    }

    .created-by {
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
        margin: 0;
        font-style: italic;
    }

    .creator {
        color: var(--sl-color-white);
        font-weight: 500;
        font-style: normal;
    }
</style>
