---
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs');

// Filter out index.mdx and other non-resource/root pages
const totalResources = allDocs.filter(doc => {
  const isIndex = doc.id === 'index.mdx' || doc.id.endsWith('/index.mdx');
  const isRootNonResource = doc.id === 'getting-started.md' || doc.id === 'contributions.md';
  const isReference = doc.id.startsWith('reference/');
  return !isIndex && !isRootNonResource && !isReference;
}).length;
---

<div class="stats-banner">
  <div class="card-bg-gradient"></div>
  <div class="stats-content">
    <span class="stat-number">{totalResources}</span>
    <span class="stat-text">Awesome Music Education resources are curated in our directory</span>
  </div>
</div>

<style>
  .stats-banner {
    position: relative;
    margin: 2rem 0;
    padding: 1.25rem 2rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(168, 85, 247, 0.05));
    border: 1px solid rgba(99, 102, 241, 0.2);
    box-shadow: 0 4px 15px -3px rgba(99, 102, 241, 0.05);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
  }

  :global([data-theme='dark']) .stats-banner {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(168, 85, 247, 0.1));
    border-color: rgba(99, 102, 241, 0.3);
  }

  .stats-banner:hover {
    transform: translateY(-2px);
    border-color: rgba(168, 85, 247, 0.4);
    box-shadow: 0 8px 25px -5px rgba(168, 85, 247, 0.15);
  }

  .card-bg-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(168, 85, 247, 0.08), transparent 70%);
    pointer-events: none;
  }

  .stats-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    text-align: center;
  }

  .stat-number {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #4f46e5, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global([data-theme='dark']) .stat-number {
    background: linear-gradient(135deg, #818cf8, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-text {
    font-size: 1.1rem;
    font-weight: 600;
    color: #475569;
    line-height: 1;
  }

  :global([data-theme='dark']) .stat-text {
    color: #cbd5e1;
  }
</style>
